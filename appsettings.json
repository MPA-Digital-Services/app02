{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost",

  "ConnectionStrings": {
    "Northwind": "Server=localhost;Database=Northwind;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },

  "Jwt": {
    "Issuer": "NorthwindApi",
    "Audience": "NorthwindClients",
    "SigningKey": "CHANGE_THIS_TO_A_SECURE_256_BIT_KEY_IN_PRODUCTION_MIN_32_CHARS",
    "ExpiryMinutes": 60,
    "ClockSkewMinutes": 5
  },

  "Cors": {
    "AllowedOrigins": [ "https://app.northwind.local", "https://admin.northwind.local" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "Accept", "X-Requested-With" ],
    "AllowCredentials": false,
    "MaxAgeSeconds": 3600
  },

  "RateLimiting": {
    "DefaultPolicy": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10,
      "QueueProcessingOrder": "OldestFirst"
    },
    "AuthPolicy": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 5
    },
    "CreateOrderPolicy": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 3
    }
  },

  "ProblemDetails": {
    "IncludeExceptionDetails": false
  }
}